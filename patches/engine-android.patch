+            // on `cur` is a plane and every band is cut from it.
+            if (!materialise_prefix()) return false;
+            Chain next;
+            if (!(this->*kFilmStages[i].run)(cur, next, error)) return false;
+            cur = next;
+            debug_stage_rows("band", kFilmStages[i].name, cur.cur);
+            ++i;
+            continue;
+        }
+        Image plane;
+        plane.h = frame_h; plane.w = frame_w; plane.c = 3;
+        plane.buf = gpu_->alloc(plane.bytes(), error);
+        if (!plane.buf) return false;
+        for (uint32_t y0 = 0; y0 < frame_h; y0 += band_rows) {
+            const uint32_t rows = std::min(band_rows, frame_h - y0);
+            const uint32_t s0 = y0 > halo ? y0 - halo : 0;
+            const uint32_t s1 = std::min(frame_h, y0 + rows + halo);
