+                                       {gpu::Arg::buf(in.buf),
+                                        gpu::Arg::inline_bytes(frame.consts, 16),
+                                        gpu::Arg::inline_bytes(meta, 6),
+                                        gpu::Arg::window(out.buf, offset,
+                                                         uint64_t(n) * frame.w * 3 * sizeof(float))},
+                                       {0u, 0u, 0u, part.c * 4u}, part, part.pixels(), error);
+        band_row0_ = saved;
+        if (!ok) return false;
+    }
