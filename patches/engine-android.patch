+namespace {
+
+uint16_t tiff16(const std::vector<uint8_t>& bytes, size_t at, bool little) {
+    if (at + 2 > bytes.size()) return 0;
+    return little ? uint16_t(bytes[at] | (uint16_t(bytes[at + 1]) << 8))
+                  : uint16_t((uint16_t(bytes[at]) << 8) | bytes[at + 1]);
+}
+
+uint32_t tiff32(const std::vector<uint8_t>& bytes, size_t at, bool little) {
+    if (at + 4 > bytes.size()) return 0;
+    if (little)
+        return uint32_t(bytes[at]) | (uint32_t(bytes[at + 1]) << 8) |
+               (uint32_t(bytes[at + 2]) << 16) | (uint32_t(bytes[at + 3]) << 24);
+    return (uint32_t(bytes[at]) << 24) | (uint32_t(bytes[at + 1]) << 16) |
+           (uint32_t(bytes[at + 2]) << 8) | uint32_t(bytes[at + 3]);
+}
+
+double tiff_value(const std::vector<uint8_t>& bytes, size_t at, uint16_t type, bool little) {
+    switch (type) {
+        case 3: return double(tiff16(bytes, at, little));
+        case 4: return double(tiff32(bytes, at, little));
+        case 5: {
+            const double num = double(tiff32(bytes, at, little));
+            const double den = double(tiff32(bytes, at + 4, little));
+            return den != 0 ? num / den : 0.0;
+        }
+        case 10: {
+            const double num = double(int32_t(tiff32(bytes, at, little)));
+            const double den = double(int32_t(tiff32(bytes, at + 4, little)));
+            return den != 0 ? num / den : 0.0;
+        }
+        case 11: {
+            uint32_t bits = tiff32(bytes, at, little);
+            float value;
+            std::memcpy(&value, &bits, sizeof value);
+            return double(value);
+        }
+        case 12: {
+            uint64_t bits = uint64_t(tiff32(bytes, at, little)) << 32 |
+                            uint64_t(tiff32(bytes, at + 4, little));
+            double value;
+            std::memcpy(&value, &bits, sizeof value);
+            return value;
+        }
+        default: return 0.0;
+    }
+}
+
+size_t tiff_unit(uint16_t type) {
+    switch (type) {
+        case 1: case 2: case 6: case 7: return 1;
+        case 3: case 8: return 2;
+        case 4: case 9: case 11: return 4;
+        case 5: case 10: case 12: return 8;
+        default: return 0;
+    }
+}
+
+}  // namespace
+
+bool read_dng_display_profile(const std::filesystem::path& source,
+                              std::vector<float>& curve, double& baseline) {
+    std::ifstream stream(source, std::ios::binary | std::ios::ate);
+    if (!stream) return false;
+    const std::streamoff size = stream.tellg();
+    if (size < 16 || size > (std::streamoff(1) << 31)) return false;
+    std::vector<uint8_t> bytes = std::vector<uint8_t>(size_t(size));
+    stream.seekg(0);
+    if (!stream.read(reinterpret_cast<char*>(bytes.data()), size)) return false;
+
+    const bool little = bytes[0] == 'I' && bytes[1] == 'I';
+    if (!little && !(bytes[0] == 'M' && bytes[1] == 'M')) return false;
+    if (tiff16(bytes, 2, little) != 42) return false;
+    const uint32_t ifd = tiff32(bytes, 4, little);
+    if (ifd < 8 || size_t(ifd) + 2 > bytes.size()) return false;
+
+    bool found = false;
+    const uint16_t entries = tiff16(bytes, ifd, little);
+    if (size_t(ifd) + 2 + size_t(entries) * 12 > bytes.size()) return false;
+    for (uint16_t i = 0; i < entries; ++i) {
+        const size_t at = size_t(ifd) + 2 + size_t(i) * 12;
+        const uint16_t tag = tiff16(bytes, at, little);
+        const uint16_t type = tiff16(bytes, at + 2, little);
+        const uint32_t count = tiff32(bytes, at + 4, little);
+        const uint32_t value = tiff32(bytes, at + 8, little);
+        const size_t unit = tiff_unit(type);
+        if (!unit || count == 0 || count > (1u << 20)) continue;
+        const size_t payload = size_t(count) * unit;
+        const size_t data_at = payload <= 4 ? at + 8 : size_t(value);
+        if (data_at + payload > bytes.size()) continue;
+        if (tag == 50940 && (type == 5 || type == 10) && count >= 1) {
+            baseline = tiff_value(bytes, data_at, type, little);
+            found = true;
+        } else if (tag == 50730) {
+            curve.clear();
+            curve.reserve(count);
+            for (uint32_t v = 0; v < count; ++v)
+                curve.push_back(float(tiff_value(bytes, data_at + size_t(v) * unit, type, little)));
+            found = true;
+        }
+    }
+    // Files without a tone curve often still carry BaselineExposure; the JNI
+    // caller turns a lone baseline into a one-element result.
+    return found;
+}
+
 }  // namespace spk::io
