+            if (!gpu_->read(img.buf.get(), size_t(y) * row * sizeof(float), host.data(),
+                            row * sizeof(float), ignored_error)) return;
+            std::fprintf(stderr, "[floats] %-6s %-20s row %-4u %s:", tag, stage, y, tail ? "tail" : "head");
+            for (int k = 0; k < 6; ++k) {
+                const size_t at = tail ? (row > 6 ? row - 6 : 0) + size_t(k) : std::min(size_t(k), row - 1);
+                uint32_t bits;
+                std::memcpy(&bits, &host[at], 4);
+                std::fprintf(stderr, " %08x", bits);
+            }
+            std::fprintf(stderr, "\n");
+        };
+        first(0, false);
+        first(img.h - 1, true);
+    }
+    // A band can be one row tall, so the probes are clamped rather than
+    // subtracted: a probe that reads outside the plane would report a hash of
+    // zeros and read as a difference that is not there.
+    auto near_end = [&](uint32_t back) { return img.h > back ? img.h - 1 - back : 0u; };
+    std::fprintf(stderr, "[stage] %-6s %-24s %ux%u  %016llx %016llx %016llx | %016llx %016llx %016llx\n",
