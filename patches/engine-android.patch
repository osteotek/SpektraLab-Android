+                // already computed, so the first run of the chain pays no copy
+                // at the boundary at all.
+                if (!film_prefix_band(prefix, s0, s1 - s0, sub, error)) return false;
+                debug_stage_rows("band", "prefix_band", sub);
+            }
+            band_row0_ = s0;
