+    for (size_t k = 0; k < kFilmStageCount; ++k) {
+        const std::string name = kFilmStages[k].name;
+        if (name == "film_log_and_curves") log_curves = k;
+        if (name == "film_couplers") couplers = k;
+    }
+    // `paired` keeps the rule honest if the table is ever renamed: without both
+    // stages found, the executor falls back to the conservative error below
+    // rather than shrinking every run against a sentinel index.
+
+    if (std::getenv("SPK_VK_LOG")) {
+        std::fprintf(stderr, "[band] frame %ux%u, %u rows a band, %s prefix\n", frame_w, frame_h,
+                     band_rows, prefix.whole_required ? "whole" : "streamed");
+    }
+
+    size_t i = 0;
+    while (i < kFilmStageCount) {
+        uint32_t halo = 0;
+        size_t j = i;
+        while (j < kFilmStageCount) {
+            uint32_t h = 0;
+            if (!band_able(j, h)) break;
+            halo += h;   // halos compose along a run -- a sum, not a max
+            ++j;
+        }
+        const bool paired = log_curves < couplers && couplers < kFilmStageCount;
+        if (paired && j > i && i <= log_curves && j <= couplers) {
+            // The producer either runs whole or the run stops before it. When
+            // `i` is already the producer the only honest plan is `j == i`.
+            j = i == log_curves ? i : std::min(j, log_curves);
+            halo = 0;
+            for (size_t k = i; k < j; ++k) {
+                uint32_t h = 0;
+                band_able(k, h);
+                halo += h;
+            }
+        }
+        if (std::getenv("SPK_VK_LOG")) {
+            std::fprintf(stderr, "[band] run %zu..%zu halo %u (%s%s)\n", i, j, halo,
+                         i == j ? "whole " : "",
+                         i < kFilmStageCount ? kFilmStages[i].name : "-");
+        }
