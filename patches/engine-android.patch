+// Independent headless probe for Vulkan highlight headroom compression kernel.
+// Validates spk_highlight_headroom against an independent float64 reference.
+#include "gpu/gpu.hpp"
+#include "gpu_vulkan_read.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace {
+using spk::gpu::Arg;
+using spk::gpu::BufferRef;
+using spk::gpu::Gpu;
+
+constexpr float kGuard = -12345.25f;
+constexpr size_t kGuardCount = 16;
+constexpr double kTolerance = 1e-5;
+
+void headroom_reference(const std::vector<float>& in, const float p[7], size_t n, std::vector<double>& expected) {
+    expected.resize(n * 3);
+    auto smoothstep01 = [](double t) {
+        t = std::clamp(t, 0.0, 1.0);
+        return t * t * (3.0 - 2.0 * t);
+    };
+    for (size_t i = 0; i < n; ++i) {
+        double vx = double(in[3 * i]);
+        double vy = double(in[3 * i + 1]);
+        double vz = double(in[3 * i + 2]);
+        double m = std::max(vx, std::max(vy, vz));
+        double g = 1.0;
+        if (m > 0.0) {
+            double lm = std::log2(m);
+            double near_clip = smoothstep01((lm + std::log2(double(p[0])) - double(p[1])) * double(p[2]));
+            double over_floor = smoothstep01((lm + std::log2(double(p[4])) - double(p[5])) * double(p[6]));
+            g = std::exp2(double(p[3]) * near_clip * over_floor);
+        }
+        expected[3 * i] = vx * g;
+        expected[3 * i + 1] = vy * g;
+        expected[3 * i + 2] = vz * g;
+    }
+}
+
+bool check_case(Gpu* gpu, const std::string& case_name, const float p[7],
+                const std::vector<float>& input, size_t n, double& max_error,
+                std::string& error) {
+    auto p_buf = gpu->upload(p, 7 * sizeof(float), error);
+    if (!p_buf) return false;
+    auto in_buf = gpu->upload(input.data(), input.size() * sizeof(float), error);
+    if (!in_buf) return false;
+
+    const size_t output_elements = n * 3;
+    std::vector<float> guarded_output(output_elements + kGuardCount, kGuard);
+    auto out_buf = gpu->upload(guarded_output.data(), guarded_output.size() * sizeof(float), error);
+    if (!out_buf) return false;
+
+    const uint32_t count_arg[1] = {uint32_t(n)};
+    if (!gpu->dispatch("spk_highlight_headroom",
+                       {Arg::buf(in_buf), Arg::buf(p_buf),
+                        Arg::inline_bytes(count_arg, 1), Arg::buf(out_buf)},
+                       std::max(n, size_t(1)), error)) {
+        return false;
+    }
+    if (!gpu->flush(error)) return false;
+
+    std::vector<float> actual;
+    if (!read_test_buffer(gpu, out_buf, actual, error)) return false;
+
+    std::vector<double> expected;
+    headroom_reference(input, p, n, expected);
+
+    for (size_t i = 0; i < expected.size(); ++i) {
+        const double delta = std::abs(double(actual[i]) - expected[i]);
+        const double tolerance = kTolerance * std::max(1.0, std::abs(expected[i]));
+        max_error = std::max(max_error, delta);
+        if (!std::isfinite(actual[i]) || delta > tolerance) {
+            char detail[320];
+            std::snprintf(detail, sizeof detail,
+                          "%s: index=%zu got=%.9g expected=%.12g delta=%.9g tolerance=%.9g",
+                          case_name.c_str(), i, double(actual[i]), expected[i], delta, tolerance);
+            error = detail;
+            return false;
+        }
+    }
+
+    // Vulkan buffer 按 512B 对齐放大，只检查实际上传的 guard 窗口
+    for (size_t i = output_elements; i < actual.size() && i < output_elements + kGuardCount; ++i) {
+        if (actual[i] != kGuard) {
+            error = case_name + ": kernel wrote beyond allocated count";
+            return false;
+        }
+    }
+    return true;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc != 2) {
+        std::fprintf(stderr, "usage: spk_vulkan_headroom <resources>\n");
+        return 2;
+    }
+
+    std::string error;
+    std::unique_ptr<Gpu> gpu(Gpu::create_vulkan(std::string(argv[1]) + "/vulkan", error));
+    if (!gpu) {
+        std::fprintf(stderr, "Vulkan device: %s\n", error.c_str());
+        return 1;
+    }
+    std::printf("Vulkan headroom device: %s\n", gpu->device_name().c_str());
+
+    constexpr double kHeadroomClipFromEv = -1.0;
+    constexpr double kHeadroomClipToEv = -0.25;
+    constexpr double kMidgray = 0.184;
+    const double clip = 4.0;
+    const double headroom_ev = 1.5;
+    const double headroom_from_ev = 0.5;
+    const double headroom_to_ev = 2.0;
+
+    const float p[7] = {
+        float(1.0 / clip),
+        float(kHeadroomClipFromEv),
+        float(1.0 / (kHeadroomClipToEv - kHeadroomClipFromEv)),
+        float(headroom_ev),
+        float(1.0 / kMidgray),
+        float(headroom_from_ev),
+        float(1.0 / (headroom_to_ev - headroom_from_ev))
+    };
+
+    double max_error = 0.0;
+    size_t passed = 0;
+
+    // Test across several sizes: single element, boundary workgroup, and large size
+    const size_t pixel_counts[] = {1, 13, 128, 256, 1025};
+    for (size_t n : pixel_counts) {
+        std::vector<float> input(n * 3);
+        for (size_t i = 0; i < n; ++i) {
+            // Sweep through shadow, midtone, highlight and near-clip/over-clip values
+            const double s = double(i) / double(std::max(n - 1, size_t(1)));
+            const double val = -0.2 + 5.0 * s;
+            input[3 * i] = float(val);
+            input[3 * i + 1] = float(val * 0.8 + 0.1);
+            input[3 * i + 2] = float(val * 1.1 - 0.05);
+        }
+
+        if (!check_case(gpu.get(), "headroom-n" + std::to_string(n), p, input, n, max_error, error)) {
+            std::fprintf(stderr, "headroom gate failed: %s\n", error.c_str());
+            return 1;
+        }
+        ++passed;
+    }
+
+    // Edge case: zero and negative inputs (boundary handling m <= 0)
+    {
+        const size_t n = 8;
+        std::vector<float> edge_input(n * 3, 0.0f);
+        edge_input[0] = -1.0f; edge_input[1] = -0.5f; edge_input[2] = 0.0f;
+        edge_input[3] = 0.0f;  edge_input[4] = 0.0f;  edge_input[5] = 0.0f;
+        edge_input[6] = 0.184f; // exactly midgray
+        edge_input[9] = 4.0f;   // exactly clip
+        if (!check_case(gpu.get(), "headroom-edge", p, edge_input, n, max_error, error)) {
+            std::fprintf(stderr, "headroom edge case failed: %s\n", error.c_str());
+            return 1;
+        }
+        ++passed;
+    }
+
+    std::printf("headroom: %zu GPU cases passed; float64 headroom compression reference; max delta %.9g\n",
+                passed, max_error);
+    return 0;
+}
diff --git a/engine/tests/gpu_vulkan_no_film.cpp b/engine/tests/gpu_vulkan_no_film.cpp
new file mode 100644
index 0000000..522db8d
--- /dev/null
+++ b/engine/tests/gpu_vulkan_no_film.cpp
@@ -0,0 +1,82 @@
+// Independent scalar decode/grade oracle, headroom, geometry and film isolation.
+#include "pipeline/view.hpp"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+using namespace spk;
+namespace {
+void check(bool ok, const std::string& why) { if (!ok) throw std::runtime_error(why); }
+Json json(const char* text) { Json out; std::string e; check(Json::parse(text, out, e), e); return out; }
+uint16_t code(const view::Result& r, size_t i) { return uint16_t(r.pixels[2*i]) | uint16_t(r.pixels[2*i+1]) << 8; }
+uint16_t quant(double v) { return uint16_t(std::lround(std::clamp(v, 0., 1.) * 65535)); }
+double encode(double linear) { return linear < 1./512 ? linear*16 : std::pow(linear, 1./1.8); }
+
+void exercise(const std::string& resources) {
+    using Engine = std::unique_ptr<spk_engine, decltype(&spk_engine_destroy)>;
+    using Session = std::unique_ptr<spk_session, decltype(&spk_session_release)>;
+    Engine engine(spk_engine_create(resources.c_str(), nullptr), spk_engine_destroy);
+    check(bool(engine), spk_last_error(nullptr));
+    constexpr uint32_t W=12, H=8;
+    std::vector<float> pixels(W*H*3);
+    constexpr std::array<float, 8> light={-.01f, 0, .0002f, .01f, .18f, .8f, 2.f, 4.f};
+    for (size_t i=0; i<pixels.size(); ++i) pixels[i]=light[(i*5+i/7)%light.size()];
+    spk_image image{pixels.data(), W, H, 3};
+    const char* params="{\"input_color_space\":\"ProPhoto RGB\",\"input_cctf_decoding\":false,\"grain_active\":true,\"halation_active\":false,\"glare_active\":false,\"auto_exposure\":false}";
+    Session session(spk_open(engine.get(), &image, params, nullptr), spk_session_release);
+    check(bool(session), spk_last_error(engine.get()));
+    std::string e; view::Request q; q.rgba16=true; q.target_space="ProPhoto RGB";
+    view::Result film, neutral, recovered, restored;
+    check(view::render(session.get(), q, film, e), e);
+    q.no_film=true;
+    check(view::render(session.get(), q, neutral, e), e);
+    check(neutral.width==W && neutral.height==H && neutral.source_width==W && neutral.source_height==H && !neutral.print_cached,
+          "no-film dimensions/cache source are wrong");
+    int worst=0;
+    for (size_t i=0; i<pixels.size(); ++i)
+        worst=std::max(worst, std::abs(int(code(neutral,(i/3)*4+i%3))-int(quant(encode(pixels[i])))));
+    check(worst<=3, "no-film neutral disagrees with independent ProPhoto OETF oracle: "+std::to_string(worst));
+    q.adjustments=json("{\"exposure\":-4}");
+    check(view::render(session.get(), q, recovered, e), e);
+    worst=0; bool exercised_headroom=false;
+    for (size_t i=0; i<pixels.size(); ++i) {
+        const double c=std::max(0.,encode(pixels[i]));
+        const auto expected=quant(std::pow(std::pow(c,2.2)/16,1./2.2));
+        const auto actual=code(recovered,(i/3)*4+i%3);
+        worst=std::max(worst,std::abs(int(actual)-int(expected)));
+        if (pixels[i]>1) {
+            exercised_headroom=true;
+            check(actual>quant(std::pow(1./16,1./2.2))+1000, "decoded highlights were clipped before exposure");
+        }
+    }
+    check(exercised_headroom && worst<=4, "no-film exposure disagrees with scalar oracle: "+std::to_string(worst));
+    q.geometry=json("{\"quarterTurns\":1,\"crop\":{\"x\":0.25,\"y\":0.25,\"width\":0.5,\"height\":0.5}}");
+    view::Result cropped; check(view::render(session.get(),q,cropped,e),e);
+    check(cropped.width==4 && cropped.height==6,"no-film crop/quarter-turn dimensions are wrong");
+    for (uint32_t y=0;y<6;++y) for(uint32_t x=0;x<4;++x) for(uint32_t c=0;c<3;++c)
+        check(code(cropped,(y*4+x)*4+c)==code(recovered,((5-x)*W+(3+y))*4+c),"no-film geometry does not match original source coordinates");
+    q.geometry=Json::object(); q.adjustments=Json::object(); q.no_film=false;
+    check(view::render(session.get(),q,restored,e) && restored.print_cached && restored.pixels==film.pixels,
+          "source bypass changed random film print cache");
+
+    check(spk_set_params(session.get(),"{\"overscan_active\":true,\"overscan_format\":\"135\",\"date_imprint_active\":true,\"date_imprint_text\":\"26 10 28\",\"geometry_crop_w\":0.5,\"geometry_crop_h\":0.5,\"digital_intermediate\":true}",nullptr)==SPK_OK,spk_last_error(engine.get()));
+    q.no_film=true; check(view::render(session.get(),q,restored,e),e);
+    check(restored.pixels==neutral.pixels && restored.width==W && restored.height==H,"film edge/date/scan geometry contaminated no-film source");
+    q.pair=Json::object(); check(!view::render(session.get(),q,restored,e) && e.find("pair")!=std::string::npos,"native request pair bypass was accepted");
+    q.pair=Json();
+    check(spk_set_params(session.get(),"{\"overscan_active\":false,\"date_imprint_active\":false,\"overscan_pair\":true,\"overscan_format\":\"135_half\",\"geometry_crop_w\":1,\"geometry_crop_h\":1}",nullptr)==SPK_OK,spk_last_error(engine.get()));
+    check(!view::render(session.get(),q,restored,e) && e.find("pair")!=std::string::npos,"native session pair bypass was accepted");
+    q.cineon=true; q.no_film=false;
+    view::Result di; check(view::render(session.get(),q,di,e),e);
+    q.no_film=true; check(!view::render(session.get(),q,restored,e) && e.find("Digital Intermediate")!=std::string::npos,"Cineon accepted no-film");
+    std::puts("no-film Vulkan: independent OETF/exposure/headroom oracle, crop+rotation, film cache, edge/date/DI isolation and both native pair guards passed");
+}
+}
+int main(int argc,char** argv) {
+    try { check(argc==2,"resource directory required"); exercise(argv[1]); return 0; }
+    catch(const std::exception& e) { std::fprintf(stderr,"%s\n",e.what()); return 1; }
+}
diff --git a/engine/tests/gpu_vulkan_smoke.cpp b/engine/tests/gpu_vulkan_smoke.cpp
index 7ce7857..217bae7 100644
--- a/engine/tests/gpu_vulkan_smoke.cpp
+++ b/engine/tests/gpu_vulkan_smoke.cpp
@@ -8,12 +8,15 @@
 #include <cstring>
 #include <limits>
 #include <string>
+#include <utility>
 #include <vector>
 
 #include "cam16.hpp"
 #include "gpu/gpu.hpp"
 #include "gpu_vulkan_read.hpp"
 #include "numeric.hpp"
+#include "pipeline/blur.hpp"
+#include "pipeline/pipeline.hpp"
 #include "spektrafilm/spk_engine.h"
 
 namespace {
@@ -295,6 +298,235 @@ bool check_iir(spk::gpu::Gpu* gpu, std::string& error) {
     return true;
 }
 
+spk::Image upload_blur_image(spk::gpu::Gpu* gpu, const std::vector<float>& pixels,
+                             uint32_t height, uint32_t width, std::string& error) {
+    spk::Image image;
+    image.h = height; image.w = width; image.c = 3;
+    image.buf = gpu->upload(pixels.data(), image.bytes(), error);
+    return image;
+}
+
+bool read_blur_image(spk::gpu::Gpu* gpu, const spk::Image& image,
+                     std::vector<float>& pixels, std::string& error) {
+    if (!image.valid() || image.c != 3) { error = "blur returned an invalid RGB image"; return false; }
+    // Read logical pixels, not a reused allocation's possibly larger capacity.
+    pixels.resize(image.elements());
+    return gpu->read(image.buf.get(), 0, pixels.data(), image.bytes(), error);
+}
+
+bool blur_bits_equal(const std::vector<float>& expected, const std::vector<float>& actual,
+                     const std::string& label, std::string& error) {
+    if (expected.size() != actual.size()) { error = label + ": shape changed"; return false; }
+    for (size_t i = 0; i < expected.size(); ++i) if (!std::isfinite(expected[i]) || !std::isfinite(actual[i])) {
+        error = label + ": nonfinite sample at " + std::to_string(i); return false;
+    }
+    if (std::memcmp(expected.data(), actual.data(), expected.size() * sizeof(float)) == 0) return true;
+    for (size_t i = 0; i < expected.size(); ++i) {
+        const auto a = std::bit_cast<uint32_t>(expected[i]), b = std::bit_cast<uint32_t>(actual[i]);
+        if (a != b) {
+            char detail[160];
+            std::snprintf(detail, sizeof detail, ": float32 bits differ at %zu: %08x != %08x", i, a, b);
+            error = label + detail; return false;
+        }
+    }
+    error = label + ": byte comparison failed"; return false;
+}
+
+void blur_fixture(uint32_t height, uint32_t width, std::vector<float>& input,
+                  std::vector<float>& accumulated) {
+    input.resize(size_t(height) * width * 3); accumulated.resize(input.size());
+    for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x)
+        for (uint32_t c = 0; c < 3; ++c) {
+            const size_t at = (size_t(y) * width + x) * 3 + c;
+            // Signed, nonseparable data and impulses at different boundaries
+            // expose pass-order, inactive-channel and reflection mistakes.
+            input[at] = float(int((17 * x + 29 * y + 11 * x * y + 37 * c) % 257) - 128) / 64.0f;
+            if ((c == 0 && x == 0 && y == 0) ||
+                (c == 1 && x == width / 2 && y == height / 2) ||
+                (c == 2 && x == width - 1 && y == height - 1)) input[at] += 3.0f;
+            accumulated[at] = float(int((3 * x + 5 * y + 7 * c) % 31) - 15) / 32.0f;
+        }
+}
+
+bool check_gaussian_consume(spk::gpu::Gpu* gpu, std::string& error) {
+    spk::Blur blur(gpu);
+    const double sigma[][3] = {
+        {0, 0, 0}, {0.01, 0.1, 0}, {0.5, 1.25, 2.999}, {3, 12, 130},
+        {0, 0.7, 2.7}, {0, 3, 12}, {0.7, 3, 0},
+        {std::nextafter(3.0, 0.0), 3.0, std::nextafter(3.0, 4.0)}
+    };
+    const double weights[][3] = {{1, 1, 1}, {-0.5, 0.25, 1.75}};
+    size_t cases = 0;
+    auto compare = [&](uint32_t height, uint32_t width, size_t which, unsigned mode, bool keep_alias) {
+        std::vector<float> input, accumulated, expected, actual, unchanged;
+        blur_fixture(height, width, input, accumulated);
+        auto acc = upload_blur_image(gpu, accumulated, height, width, error);
+        if (!acc.valid()) return false;
+        const spk::Image* accumulation = mode ? &acc : nullptr;
+        const double* weight = mode ? weights[mode - 1] : nullptr;
+        const std::string label = "gaussian consume " + std::to_string(height) + "x" + std::to_string(width) +
+            " sigma=" + std::to_string(which) + " acc=" + std::to_string(mode) + " alias=" + std::to_string(keep_alias);
+        {
+            auto source = upload_blur_image(gpu, input, height, width, error);
+            spk::Image out;
+            if (!source.valid() || !blur.gaussian(source, sigma[which], out, error, 3.0, accumulation, weight) ||
+                !gpu->flush(error) || !read_blur_image(gpu, out, expected, error)) return false;
+            if (out.h != height || out.w != width) { error = label + ": baseline dimensions changed"; return false; }
+            if (!read_blur_image(gpu, acc, unchanged, error) ||
+                !blur_bits_equal(accumulated, unchanged, label + " baseline accumulator", error)) return false;
+        } // The baseline's GPU input and result must not survive into the candidate.
+        {
+            auto source = upload_blur_image(gpu, input, height, width, error);
+            if (!source.valid()) return false;
+            spk::Image alias;
+            if (keep_alias) alias = source;
+            spk::Image out;
+            if (!blur.gaussian_consume(std::move(source), sigma[which], out, error, 3.0, accumulation, weight) ||
+                !gpu->flush(error) || !read_blur_image(gpu, out, actual, error)) return false;
+            if (out.h != height || out.w != width) { error = label + ": candidate dimensions changed"; return false; }
+            if (!blur_bits_equal(expected, actual, label, error)) return false;
+            if (keep_alias && (!read_blur_image(gpu, alias, unchanged, error) ||
+                !blur_bits_equal(input, unchanged, label + " retained input", error))) return false;
+            if (!read_blur_image(gpu, acc, unchanged, error) ||
+                !blur_bits_equal(accumulated, unchanged, label + " accumulator", error)) return false;
+        }
+        ++cases; return true;
+    };
+    for (size_t which = 0; which < std::size(sigma); ++which)
+        for (unsigned mode = 0; mode < 3; ++mode)
+            for (bool alias : {false, true}) if (!compare(19, 13, which, mode, alias)) return false;
+    const uint32_t boundaries[][2] = {{1, 1}, {1, 7}, {7, 1}, {3, 257}, {257, 3}};
+    for (const auto& shape : boundaries) for (size_t which : {size_t(2), size_t(3)})
+        for (unsigned mode = 0; mode < 3; ++mode) if (!compare(shape[0], shape[1], which, mode, false)) return false;
+
+    // Requested-live bytes exclude pool capacity/reuse accidents. The same
+    // accumulator stays alive outside both windows; inputs are uploaded before
+    // observation, and readback begins only after each window has closed.
+    constexpr uint32_t side = 512;
+    constexpr size_t plane_bytes = size_t(side) * side * 3 * sizeof(float);
+    std::vector<float> input, accumulated, baseline, candidate, unchanged;
+    blur_fixture(side, side, input, accumulated);
+    auto acc = upload_blur_image(gpu, accumulated, side, side, error);
+    if (!acc.valid()) return false;
+    auto peak = [&](bool consume, spk::gpu::Gpu::MemoryObservation& observation, std::vector<float>& pixels) {
+        auto source = upload_blur_image(gpu, input, side, side, error);
+        if (!source.valid()) return false;
+        spk::Image out;
+        const uint64_t token = gpu->begin_memory_observation();
+        if (!token) { error = "gaussian consume peak observation unavailable"; return false; }
+        const bool ok = consume
+            ? blur.gaussian_consume(std::move(source), sigma[2], out, error, 3.0, &acc, weights[0])
+            : blur.gaussian(source, sigma[2], out, error, 3.0, &acc, weights[0]);
+        const bool complete = ok && gpu->flush(error);
+        observation = gpu->end_memory_observation(token);
+        if (!complete || !read_blur_image(gpu, out, pixels, error)) return false;
+        if (!read_blur_image(gpu, acc, unchanged, error) ||
+            !blur_bits_equal(accumulated, unchanged, "gaussian peak accumulator", error)) return false;
+        return true;
+    };
+    spk::gpu::Gpu::MemoryObservation old_peak, new_peak;
+    if (!peak(false, old_peak, baseline) || !peak(true, new_peak, candidate) ||
+        !blur_bits_equal(baseline, candidate, "gaussian consume peak pixels", error)) return false;
+    if (old_peak.requested_live_peak < new_peak.requested_live_peak ||
+        old_peak.requested_live_peak - new_peak.requested_live_peak != plane_bytes) {
+        error = "gaussian consume FIR requested-live peak must drop one plane: old=" +
+            std::to_string(old_peak.requested_live_peak) + " new=" + std::to_string(new_peak.requested_live_peak) +
+            " expected saving=" + std::to_string(plane_bytes);
+        return false;
+    }
+    const auto audit = gpu->pool_stats().audit;
+    if (audit.pending_held || audit.over_releases || audit.reclaim_while_encoding || audit.live_underflows) {
+        error = "gaussian consume violated pool ownership audit"; return false;
+    }
+    std::printf("gaussian consume: %zu bit-exact cases, input aliases/accumulators unchanged; FIR requested-live peak %zu -> %zu (one %zu-byte plane)\n",
+                cases, old_peak.requested_live_peak, new_peak.requested_live_peak, plane_bytes);
+    return true;
+}
+
+bool check_stage_handoff(spk::gpu::Gpu* gpu, const std::string& resources, std::string& error) {
+    constexpr uint32_t side = 512;
+    constexpr size_t plane_bytes = size_t(side) * side * 3 * sizeof(float);
+    spk::Blob blob;
+    spk::Colour colour;
+    spk::SetupCache cache;
+    spk::Params params;
+    if (!blob.open(resources + "/spektrafilm_constants.bin", error) || !colour.init(blob, error) ||
+        !spk::init_params(resources, "kodak_portra_400", "kodak_portra_endura", spk::Json::object(), params, error)) return false;
+    params.scanner.lens_blur = 0.8;
+    params.scanner.unsharp_mask[0] = 0.7;
+    params.scanner.unsharp_mask[1] = 0.7;
+    spk::Pipeline pipeline(gpu, &colour, &blob, &cache);
+    if (!pipeline.build(params, error)) return false;
+    pipeline.set_source_shape(side, side, side, side); // unsharp tier ratio is exactly one
+    spk::Blur blur(gpu);
+    std::vector<float> input, expected;
+    {
+        std::vector<float> unused;
+        blur_fixture(side, side, input, unused);
+    }
+    // Keep this independent carried field alive outside both observation
+    // windows. Moving a Chain must preserve more than its current image.
+    const std::vector<float> log_pixels = {-0.0f, 0.125f, -0.25f, 0.5f, 1.0f, 2.0f,
+                                          -4.0f, 8.0f, 0.0625f, 0.375f, -0.75f, 1.5f};
+    auto log_e = upload_blur_image(gpu, log_pixels, 2, 2, error);
+    if (!log_e.valid()) return false;
+    {
+        // Explicit old numerical sequence is the raw-float oracle; do not use
+        // another stage call as the only witness that its output is unchanged.
+        const double scanner_sigma[3] = {0.8, 0.8, 0.8}, unsharp_sigma[3] = {0.7, 0.7, 0.7};
+        const double a[3] = {1.7, 1.7, 1.7}, b[3] = {-0.7, -0.7, -0.7};
+        auto source = upload_blur_image(gpu, input, side, side, error);
+        spk::Image scan, mask, reference;
+        if (!source.valid() || !blur.gaussian(source, scanner_sigma, scan, error) ||
+            !blur.gaussian(scan, unsharp_sigma, mask, error) ||
+            !blur.lincomb(scan, mask, a, b, reference, error) || !gpu->flush(error) ||
+            !read_blur_image(gpu, reference, expected, error)) return false;
+    } // All oracle GPU input/intermediates/results die before either stage run.
+
+    auto run = [&](bool retain_input, spk::gpu::Gpu::MemoryObservation& peak) {
+        spk::Pipeline::Chain in, out;
+        in.cur = upload_blur_image(gpu, input, side, side, error);
+        in.log_e_film = log_e;
+        if (!in.cur.valid()) return false;
+        spk::Image alias;
+        if (retain_input) alias = in.cur;
+        const uint64_t token = gpu->begin_memory_observation();
+        if (!token) { error = "stage handoff peak observation unavailable"; return false; }
+        const bool complete = pipeline.print_scan_finish(std::move(in), out, error) && gpu->flush(error);
+        peak = gpu->end_memory_observation(token);
+        if (!complete) return false;
+        if (in.cur.valid() || in.log_e_film.valid() || out.cur.h != side || out.cur.w != side ||
+            out.log_e_film.buf.get() != log_e.buf.get() || out.log_e_film.h != 2 ||
+            out.log_e_film.w != 2 || out.log_e_film.c != 3) {
+            error = "stage handoff lost a Chain field, its shape, or transferred ownership"; return false;
+        }
+        std::vector<float> actual, unchanged;
+        if (!read_blur_image(gpu, out.cur, actual, error) ||
+            !blur_bits_equal(expected, actual, retain_input ? "stage retained-input pixels" : "stage unique-input pixels", error) ||
+            !read_blur_image(gpu, out.log_e_film, unchanged, error) ||
+            !blur_bits_equal(log_pixels, unchanged, "stage carried log exposure", error)) return false;
+        if (retain_input && (!read_blur_image(gpu, alias, unchanged, error) ||
+                             !blur_bits_equal(input, unchanged, "stage retained input", error))) return false;
+        return true;
+    };
+    spk::gpu::Gpu::MemoryObservation retained, unique;
