+    std::string ignored_error;
+    auto hash_row = [&](uint32_t y) -> uint64_t {
+        if (!gpu_->read(img.buf.get(), size_t(y) * row * sizeof(float), host.data(),
+                        row * sizeof(float), ignored_error)) return 0;
+        uint64_t h = 1469598103934665603ull;
+        for (size_t i = 0; i < row; ++i) {
+            uint32_t bits;
+            std::memcpy(&bits, &host[i], 4);
+            h ^= bits;
+            h *= 1099511628211ull;
+        }
+        return h;
+    };
