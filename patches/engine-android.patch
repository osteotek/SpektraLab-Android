+            for (size_t k = i; k < j; ++k) {
+                Chain next;
+                if (!(this->*kFilmStages[k].run)(ch, next, error)) return false;
+                if (next.cur.h != ch.cur.h || next.cur.w != ch.cur.w || next.cur.c != ch.cur.c) {
+                    error = std::string("a banded stage changed the band's shape: ") + kFilmStages[k].name;
+                    return false;
+                }
+                ch = next;
+            }
+            band_row0_ = 0;
+            strip_plane_h_ = 0;
+            if (ch.log_e_film.buf) {
+                // Unreachable while the plan above keeps the producer and its
+                // consumer in one run; it is here so that a table edit which
+                // breaks that pairing fails loudly instead of dropping a plane.
+                error = "a banded run produced log_e_film; the plan cut its consumer off";
+                return false;
+            }
+            if (!gpu_->flush(error)) return false;
+            if (!gpu_->copy(plane.buf.get(), size_t(y0) * row_bytes, ch.cur.buf.get(),
+                            size_t(y0 - s0) * row_bytes, size_t(rows) * row_bytes, error)) return false;
+        }
