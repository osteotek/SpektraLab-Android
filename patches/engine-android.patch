+    {"path": "Nikon Z7ii/_DSC2715.NEF", "make": "Nikon", "model": "Z 7_2", "size": (8288, 5520), "orientation": 1,
+     "decoder": "nikon_load_raw()", "decode": True, "pin": "identical"},
+    {"path": "Nikon Z7ii/_DSC8127.NEF", "make": "Nikon", "model": "Z 7_2", "size": (5520, 8288), "orientation": 8,
+     "decoder": "nikon_load_raw()", "decode": True, "pin": "identical"},
+    {"path": "Nikon Z7ii/_DSC8683.NEF", "make": "Nikon", "model": "Z 7_2", "size": (5520, 8288), "orientation": 8,
+     "decoder": "nikon_load_raw()", "decode": True, "pin": "identical"},
+    {"path": "Olympus E300/sample1.orf", "make": "Olympus", "model": "E-300", "size": (3340, 2504),
+     "orientation": 1, "decoder": "packed_load_raw()", "decode": True, "pin": "identical"},
+]
+
+FAILURES: list[str] = []
+
+
+def check(cond, label, detail=""):
+    print(("ok   " if cond else "FAIL ") + label + (f"  ({detail})" if detail else ""), flush=True)
+    if not cond:
+        FAILURES.append(label)
+    return bool(cond)
+
+
+def fixture_root() -> Path:
+    root = os.environ.get("SPEKTRALAB_RAW_FIXTURES")
+    if not root:
+        print("FAIL SPEKTRALAB_RAW_FIXTURES is not set; the RAW fixtures are required, not optional", flush=True)
+        sys.exit(1)
+    path = Path(root)
+    if not path.is_dir():
+        print(f"FAIL SPEKTRALAB_RAW_FIXTURES={root} is not a folder", flush=True)
+        sys.exit(1)
+    return path
+
+
+def inventory(root: Path) -> list[dict]:
+    """The table, with every listed file present and every RAW file listed."""
+    listed = {row["path"] for row in FIXTURES}
+    for row in FIXTURES:
+        check((root / row["path"]).is_file(), f"fixture present: {row['path']}")
+    for path in sorted(p for p in root.rglob("*") if p.is_file()):
+        rel = path.relative_to(root).as_posix()
+        ext = path.suffix.lower()
+        if ext in RAW_EXTENSIONS:
+            check(rel in listed, f"RAW file has an expected-outcome row: {rel}")
+        elif ext not in IGNORED_EXTENSIONS and path.name.lower() != ".ds_store":
+            check(False, f"unrecognised fixture file (add it to the table or the ignored list): {rel}")
+    return [row for row in FIXTURES if (root / row["path"]).is_file()]
+
+
+# --- T-A1 ---------------------------------------------------------------------------------------
+
+def picture_stats(px: bytes, width: int, height: int) -> dict:
+    n = width * height
+    step = max(1, n // 200_000)
+    lum, clipped, dark = [], 0, 0
+    for i in range(0, n, step):
+        r, g, b = px[4 * i], px[4 * i + 1], px[4 * i + 2]
+        y = 0.2126 * r + 0.7152 * g + 0.0722 * b
+        lum.append(y)
+        clipped += max(r, g, b) >= 254
+        dark += max(r, g, b) <= 4
+    mean = sum(lum) / len(lum)
+    sd = math.sqrt(sum((v - mean) ** 2 for v in lum) / len(lum))
+    return {"mean": mean, "sd": sd, "clipped": clipped / len(lum), "dark": dark / len(lum)}
+
+
+def plausible(stats: dict) -> bool:
+    # Not constant, not black, not blown: generous bounds a broken decode
+    # (all-black, all-white, a flat field, NaNs turned to 0) cannot meet.
+    return 12 <= stats["mean"] <= 240 and stats["sd"] >= 6 and stats["clipped"] < 0.5 and stats["dark"] < 0.5
+
+
+def view(host: Host, sid: str, label: str, opened: dict) -> None:
+    h, _ = host.call("get_params", {"session": sid})
+    if not check(h["ok"], f"{label}: get_params", h.get("error")):
+        return
+    req = {"session": sid, "tier": "preview", "display": "srgb", "format": "rgba8", "generation": 1,
+           "params": h["result"]["params"], "long_edge": 512, "adjustments": {}, "geometry": {}}
+    h, px = host.call("render_view", req)
+    if not check(h["ok"], f"{label}: render_view", h.get("error")):
+        return
+    im = h["result"]["image"]
+    w, hh = im["width"], im["height"]
+    check(len(px) == w * hh * 4 and max(w, hh) <= 512 and (w >= hh) == (opened["width"] >= opened["height"]),
+          f"{label}: render_view size and orientation", f"{w}x{hh}")
+    s = picture_stats(px, w, hh)
+    check(plausible(s), f"{label}: picture is not constant, not black, plausibly exposed",
+          "mean {mean:.1f} sd {sd:.1f} clipped {clipped:.3f} dark {dark:.3f}".format(**s))
+
+
+def host_check(args) -> None:
+    root = fixture_root()
+    rows = inventory(root)
+    host = Host([args.host, "--resources", args.resources])
+    h, _ = host.call("hello")
+    check(h["ok"] and h["result"]["backend"].get("available"), "host: hello, Vulkan backend available",
+          h.get("error") or h["result"].get("build_info"))
+    for row in rows:
+        path, label = str(root / row["path"]), row["path"]
+        h, _ = host.call("probe", {"path": path})
+        if not check(h["ok"], f"{label}: probe", h.get("error")):
+            continue
+        r = h["result"]
+        md = r.get("metadata", {})
+        check(r["kind"] == "raw", f"{label}: probe kind raw", r["kind"])
+        check((r["width"], r["height"]) == tuple(row["size"]), f"{label}: probe displayed size",
+              f'{r["width"]}x{r["height"]}, want {row["size"][0]}x{row["size"][1]}')
+        check(md.get("make") == row["make"] and md.get("model") == row["model"], f"{label}: make and model",
+              f'{md.get("make")} / {md.get("model")}')
+        check(md.get("orientation") == row["orientation"], f"{label}: EXIF orientation",
+              f'{md.get("orientation")}, want {row["orientation"]}')
+        h, px = host.call("thumbnail", {"path": path, "long_edge": 320})
+        if check(h["ok"], f"{label}: thumbnail", h.get("error")):
+            im = h["result"]["image"]
+            ok = len(px) == im["width"] * im["height"] * 4 and max(im["width"], im["height"]) <= 320
+            check(ok and (im["width"] >= im["height"]) == (r["width"] >= r["height"]),
+                  f"{label}: thumbnail payload and orientation",
+                  f'{im["width"]}x{im["height"]} {h["result"].get("source")}')
+            s = picture_stats(px, im["width"], im["height"])
+            # The camera's own preview keeps the scene's exposure: the two Leica
+            # Q3 night frames preview at a mean of 4-6 of 255. Not constant and
+            # not all black is what can be asked of it.
+            check(s["sd"] >= 6 and s["mean"] >= 2 and s["dark"] < 0.99, f"{label}: thumbnail is a picture",
+                  "mean {mean:.1f} sd {sd:.1f}".format(**s))
+        for mode in ("compatible16", "headroom"):
+            h, _ = host.call("open", {"path": path, "decode": {"raw_mode": mode}})
+            if not row["decode"]:
+                err = h.get("error") or {}
+                check(not h["ok"] and err.get("code") == row["error_code"] and row["error"] in err.get("message", ""),
+                      f"{label}: {mode} refused as expected", err or "it decoded")
+                if h["ok"]:
+                    host.call("close", {"session": h["result"]["session"]})
+                continue
+            if not check(h["ok"], f"{label}: open {mode}", h.get("error")):
+                continue
+            o = h["result"]
+            check((o["width"], o["height"]) == tuple(row["size"]) and o["kind"] == "raw",
+                  f"{label}: {mode} size matches the table", f'{o["width"]}x{o["height"]}')
+            check(o["metadata"].get("model") == row["model"], f"{label}: {mode} model", o["metadata"].get("model"))
+            view(host, o["session"], f"{label}: {mode}", o)
+            host.call("close", {"session": o["session"]})
+    h, _ = host.call("shutdown")
+    host.p.wait(timeout=60)
+    check(host.p.returncode == 0, "host: clean shutdown", host.p.returncode)
+
+
+# --- T-A2 ---------------------------------------------------------------------------------------
+
+def dump(tool: Path, raw: Path, mode: str, out: Path):
+    p = subprocess.run([str(tool), str(raw), mode, str(out)], capture_output=True, text=True)
+    return p.returncode, (p.stdout + p.stderr).strip()
+
+
+def header(path: Path) -> dict:
+    out = {}
+    with open(path, "rb") as f:
+        assert f.readline() == b"SPKF32 1\n"
+        while True:
+            line = f.readline().decode("utf-8").rstrip("\n")
+            if not line:
+                return out
+            k, _, v = line.partition(" ")
+            out[k] = v
+
+
+def compare_check(args) -> None:
+    root = fixture_root()
+    rows = inventory(root)
+    old_dump, new_dump = Path(args.old) / "raw_decode_dump", Path(args.new) / "raw_decode_dump"
+    compare = Path(args.new) / "raw_frame_compare"
+    scratch = Path(args.scratch)
+    scratch.mkdir(parents=True, exist_ok=True)
+    a, b = scratch / "old.spkf32", scratch / "new.spkf32"
+    report = []
+    for row in rows:
+        raw, label, pin = root / row["path"], row["path"], row["pin"]
+        for mode in ("compatible16", "headroom"):
+            try:
+                oc, otext = dump(old_dump, raw, mode, a)
+                nc, ntext = dump(new_dump, raw, mode, b)
+                tag = f"{label}: {mode}"
+                if not row["decode"]:
+                    check(oc == 3 and nc == 3 and row["error"] in ntext and row["error"] in otext,
+                          f"{tag}: refused by both pins", f"old {oc} {otext} | new {nc} {ntext}")
+                    report.append({"file": label, "mode": mode, "old": otext, "new": ntext})
+                    continue
+                if not check(nc == 0, f"{tag}: the current pin decodes", ntext):
+                    continue
+                hb = header(b)
+                check(hb["nonfinite"] == "0", f"{tag}: every sample finite", hb["nonfinite"])
+                check(hb["decoder"] == row["decoder"], f"{tag}: decoder", hb["decoder"])
+                if pin == "new":
+                    check(oc == 3, f"{tag}: the previous pin refused it", otext)
+                    report.append({"file": label, "mode": mode, "old": otext, "new": ntext})
+                    continue
+                if not check(oc == 0, f"{tag}: the previous pin decodes", otext):
+                    continue
+                p = subprocess.run([str(compare), str(a), str(b)], capture_output=True, text=True)
+                if not check(p.returncode == 0, f"{tag}: compare", p.stderr.strip()):
+                    continue
+                d = json.loads(p.stdout)
+                entry = {"file": label, "mode": mode, "result": d}
+                report.append(entry)
+                check(d["same_flip"], f"{tag}: same orientation", f'{d["a"]["flip"]} / {d["b"]["flip"]}')
+                if pin == "identical":
+                    ok = d["same_size"] and d["max_abs"] == 0 and d["nonfinite"] == 0
+                    check(ok, f"{tag}: bit-identical to the previous pin",
+                          "size {}x{} -> {}x{}, max {}, mean {}".format(d["a"]["width"], d["a"]["height"], d["b"]["width"],
+                                                                        d["b"]["height"], d.get("max_abs"), d.get("mean_abs")))
+                elif "crop" in pin:
+                    c = pin["crop"]
+                    al = d.get("aligned") or {}
+                    grew = (int(d["b"]["width"]) - int(d["a"]["width"]), int(d["b"]["height"]) - int(d["a"]["height"]))
+                    check(grew == (c["w"], c["h"]) and al.get("offset_x") == c["x"] and al.get("offset_y") == c["y"],
+                          f"{tag}: the new crop contains the old frame where recorded",
+                          f"grew {grew}, offset {al.get('offset_x')},{al.get('offset_y')}")
+                    check(al.get("max_abs") == 0 and al.get("samples", 0) > 0, f"{tag}: the overlap is bit-identical",
+                          f"max {al.get('max_abs')} over {al.get('samples')} samples")
+                elif "colour" in pin:
+                    bound = pin["colour"][mode]
+                    check(d["same_size"] and d["mean_abs"] <= bound["mean_abs"] and d["max_abs"] <= bound["max_abs"],
+                          f"{tag}: changed only by upstream colour data, within the recorded bound",
+                          f"mean {d.get('mean_abs'):.3g} <= {bound['mean_abs']}, max {d.get('max_abs'):.3g} <= {bound['max_abs']}")
+                    check(d["mean_abs"] > 0, f"{tag}: the recorded change is still there (else make the row identical)")
+                else:
+                    check(False, f"{tag}: unknown pin expectation {pin!r}")
+            finally:
+                for f in (a, b):
+                    f.unlink(missing_ok=True)
+    if args.report:
+        Path(args.report).write_text(json.dumps(report, indent=1) + "\n", encoding="utf-8")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    h = sub.add_parser("host")
+    h.add_argument("--host", required=True)
+    h.add_argument("--resources", required=True)
+    c = sub.add_parser("compare")
+    c.add_argument("--old", required=True, help="build dir of raw_pin_compare against the previous pin")
+    c.add_argument("--new", required=True, help="build dir of raw_pin_compare against the current pin")
+    c.add_argument("--scratch", required=True, help="where the frames are written (and deleted)")
+    c.add_argument("--report", help="write every comparison as JSON here")
+    args = ap.parse_args()
+    (host_check if args.cmd == "host" else compare_check)(args)
+    print(f"\n{len(FAILURES)} failure(s)" + ("" if not FAILURES else ": " + "; ".join(FAILURES[:20])), flush=True)
+    return 1 if FAILURES else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/engine/tests/raw_gate.sh b/engine/tests/raw_gate.sh
new file mode 100755
index 0000000..2de91d7
--- /dev/null
+++ b/engine/tests/raw_gate.sh
@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+# raw_gate.sh -- the LibRaw gate on a Mac (PRD-W3 T-A1..T-A4, and the engine's
+# own CTests in the MoltenVK build). Exit 0 only if every step passed.
+#
+#   SPEKTRALAB_RAW_FIXTURES=<folder of camera files> engine/tests/raw_gate.sh
+#
+#   0. engine/setup-libraw.sh verifies (or fetches) the pinned LibRaw tree.
+#   1. The native host against MoltenVK (engine/LINUX_WINDOWS.md §7) is built
+#      in build/raw-gate-mac, with native codec prefixes from the setup
+#      scripts and the pinned Vulkan-Headers (not /opt/homebrew/include, whose
+#      jpeglib.h is libjpeg 8 and fails spk_host_codecs); its CTests must pass.
+#   2. T-A1 engine/tests/raw_fixtures.py host: every fixture through that host.
+#   3. T-A2 engine/tests/raw_pin_compare.sh: the previous pin against this one.
+#   4. T-A3 engine/tests/raw_pin_guard.sh: the pin guards fire.
+#   5. T-A4 engine/build-windows-cross.sh: spektralab-host.exe is PE32+
+#      x86-64, imports system DLLs only (the script's own allowlist), carries
+#      this LibRaw, and the staged licences name it.
+# No step is skipped: the fixture variable unset, a tool missing or a step
+# failing fails the gate. No timing is measured or asserted.
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+engine="$(cd "$here/.." && pwd)"
+repo="$(cd "$engine/.." && pwd)"
+deps="${SPEKTRALAB_DEPS_DIR:-$repo/build/deps}"
+mac="${SPEKTRALAB_RAW_GATE_BUILD:-$repo/build/raw-gate-mac}"
+fail() { echo "FAIL $*" >&2; exit 1; }
+ok() { echo "ok   $*"; }
+[[ -n "${SPEKTRALAB_RAW_FIXTURES:-}" && -d "$SPEKTRALAB_RAW_FIXTURES" ]] \
+  || fail "SPEKTRALAB_RAW_FIXTURES must name the RAW fixture folder (required, never skipped)"
+[[ "$(uname -s)" == Darwin ]] || fail "this gate is the Mac gate (MoltenVK host); Linux runs build-linux.sh"
+for tool in cmake ninja python3 git glslangValidator x86_64-w64-mingw32-g++ x86_64-w64-mingw32-objdump; do
+  command -v "$tool" >/dev/null || fail "$tool not found"
+done
+export DYLD_FALLBACK_LIBRARY_PATH="${DYLD_FALLBACK_LIBRARY_PATH:-/opt/homebrew/lib}"   # volk dlopens libvulkan
+logs="$repo/build/raw-gate-logs"
+mkdir -p "$logs"
+step() {   # name log command...: run, keep the log, fail with its tail
+  local name="$1" log="$logs/$2"; shift 2
+  if "$@" > "$log" 2>&1; then return 0; fi
+  tail -25 "$log" >&2
+  fail "$name (log: $log)"
+}
+
+# --- 0. the pin --------------------------------------------------------------------------------
+"$engine/setup-deps.sh" "$deps" > "$logs/setup-deps.txt" 2>&1 || { tail -20 "$logs/setup-deps.txt"; fail "setup-deps.sh"; }
+libraw="$("$engine/setup-libraw.sh" "$deps" 2>/dev/null | tail -n 1)"
+ok "LibRaw pin verified: $libraw"
+
+# --- 1. the native MoltenVK host and its CTests -------------------------------------------------
+step "native input codecs" input-codecs.txt python3 "$engine/setup-input-codecs.py" --sources "$deps/input-codecs" \
+  --build "$mac/codecs/input" --install "$deps/input-codecs/install-mac" --generator Ninja
+step "native lens codecs" lens-codecs.txt python3 "$engine/setup-lens-codecs.py" --sources "$deps/lens-codecs" \
+  --build "$mac/codecs/lens" --install "$deps/lens-codecs/install-mac" --generator Ninja
+step "configure the MoltenVK host" configure.txt cmake -S "$repo" -B "$mac" -G Ninja -DCMAKE_BUILD_TYPE=Release \
+  -DSPEKTRALAB_VULKAN_ON_APPLE=ON -DSPEKTRALAB_REQUIRE_VULKAN=ON \
+  -DSPEKTRALAB_VULKAN_HEADERS="$deps/Vulkan-Headers/include" \
+  -DSPEKTRALAB_BUILD_NATIVE_RAW=ON -DSPEKTRALAB_BUILD_HOST=ON -DSPEKTRALAB_LIBRAW_OPENMP=OFF \
+  -DSPEKTRALAB_LIBRAW_SOURCE="$libraw" \
+  -DSPEKTRALAB_INPUT_CODEC_PREFIX="$deps/input-codecs/install-mac" \
+  -DSPEKTRALAB_LENS_PREFIX="$deps/lens-codecs/install-mac" -DBUILD_TESTING=ON
+step "build the MoltenVK host" build.txt ninja -C "$mac"
+step "CTest (MoltenVK build)" ctest.txt ctest --test-dir "$mac" --output-on-failure
+ok "native build and CTests: $(grep -E 'tests passed' "$logs/ctest.txt")"
+
+# --- 2. T-A1 ---------------------------------------------------------------------------------
+step "T-A1 raw_fixtures.py host" t-a1.txt python3 "$here/raw_fixtures.py" host \
+  --host "$mac/engine/host/spektralab-host" --resources "$mac/engine/resources"
+ok "T-A1 every fixture through the host: $(grep -c '^ok' "$logs/t-a1.txt") checks, $(tail -n 1 "$logs/t-a1.txt")"
+
+# --- 3. T-A2 ---------------------------------------------------------------------------------
+step "T-A2 raw_pin_compare.sh" t-a2.txt "$here/raw_pin_compare.sh" "$repo/build/raw-pin-compare"
+ok "T-A2 previous pin against this one: $(grep -c '^ok' "$logs/t-a2.txt") checks, $(tail -n 1 "$logs/t-a2.txt")"
+
+# --- 4. T-A3 ---------------------------------------------------------------------------------
+step "T-A3 raw_pin_guard.sh" t-a3.txt "$here/raw_pin_guard.sh" "$repo/build/raw-pin-guard"
+ok "T-A3 the pin guards fire: $(grep -c '^ok' "$logs/t-a3.txt") checks, $(tail -n 1 "$logs/t-a3.txt")"
+
+# --- 5. T-A4 ---------------------------------------------------------------------------------
+step "T-A4 build-windows-cross.sh" t-a4.txt "$engine/build-windows-cross.sh"
+exe="$repo/build/host-win-x64/spektralab-host.exe"
+lic="$repo/build/host-win-x64/licenses"
+file "$exe" | grep -q 'PE32+ executable (console) x86-64' || fail "T-A4: $(file -b "$exe")"
+imports="$(x86_64-w64-mingw32-objdump -p "$exe" | awk '/DLL Name/ {print $3}' | sort -u | tr '\n' ' ')"
+grep -qiE 'libstdc|libgcc|libwinpthread|libgomp|vulkan-1|libraw' <<<"$imports" && fail "T-A4: non-system import in [$imports]"
+LC_ALL=C grep -aq "0.23.0-Snapshot202611" "$exe" || fail "T-A4: the exe does not carry LibRaw 0.23.0-Snapshot202611"
+LC_ALL=C grep -aq "0.22.2-Release" "$exe" && fail "T-A4: the exe still carries LibRaw 0.22.2"
+for f in LibRaw-LGPL-2.1.txt LibRaw-COPYRIGHT.txt LibRaw-SOURCE.txt; do [[ -s "$lic/$f" ]] || fail "T-A4: licenses/$f not staged"; done
+grep -q "42f89c165763272a5482a254c446337f8048e0df" "$lic/LibRaw-SOURCE.txt" || fail "T-A4: LibRaw-SOURCE.txt does not name the pinned commit"
+grep -q "GNU LESSER GENERAL PUBLIC LICENSE" "$lic/LibRaw-LGPL-2.1.txt" || fail "T-A4: LibRaw-LGPL-2.1.txt is not the LGPL"
+ok "T-A4 spektralab-host.exe: PE32+ x86-64, $(wc -c < "$exe" | tr -d ' ') bytes, imports [$imports], LibRaw 0.23.0-Snapshot202611, LibRaw notices staged"
+echo
+echo "raw gate: all passed (logs in $logs)"
diff --git a/engine/tests/raw_pin_compare.sh b/engine/tests/raw_pin_compare.sh
new file mode 100755
index 0000000..73169d2
--- /dev/null
+++ b/engine/tests/raw_pin_compare.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# raw_pin_compare.sh -- T-A2: the previous LibRaw pin against the current one.
+#
+#   SPEKTRALAB_RAW_FIXTURES=<folder> engine/tests/raw_pin_compare.sh [work-dir]
+#
+# Builds raw_pin_compare/ (spk::io's decoder and LibRaw, nothing else) twice
+# with the same compiler and flags:
+#   old  engine/src/io and engine/setup-libraw.sh + third_party/libraw-arw6 as
+#        they were at SPEKTRALAB_RAW_OLD_PIN_COMMIT (default 1aa6f4d8, the
+#        Windows v1 line: LibRaw 0.22.2 + the ARW 6 overlay + raw_camera.hpp's
+#        matrices), extracted with `git archive` and set up by that commit's
+#        own script, which verifies its tree exactly as it always did;
+#   new  this checkout's engine/src/io against the tree engine/setup-libraw.sh
+#        verifies;
+# then runs `raw_fixtures.py compare`, which decodes every fixture with both
+# and holds each file to its row's `pin` expectation. Frames are written to
+# <work-dir>/frames one at a time and deleted after each comparison.
+# Default work dir: <repo>/build/raw-pin-compare. Exit status 0 only if every
+# check passed. Needs cmake, ninja, a C++20 compiler and git (for the archive).
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repo="$(cd "$here/../.." && pwd)"
+work="${1:-$repo/build/raw-pin-compare}"
+deps="${SPEKTRALAB_DEPS_DIR:-$repo/build/deps}"
+old_commit="${SPEKTRALAB_RAW_OLD_PIN_COMMIT:-1aa6f4d8}"
+[[ -n "${SPEKTRALAB_RAW_FIXTURES:-}" ]] || { echo "FAIL SPEKTRALAB_RAW_FIXTURES is not set" >&2; exit 1; }
+mkdir -p "$work" "$deps"
+
+# The previous pin, from its own commit.
+rm -rf "$work/old-src"
+mkdir -p "$work/old-src"
+git -C "$repo" archive "$old_commit" engine/setup-libraw.sh engine/third_party/libraw-arw6 engine/src/io \
+  | tar -x -C "$work/old-src"
+old_libraw="$("$work/old-src/engine/setup-libraw.sh" "$deps" | tail -n 1)"
+new_libraw="$("$repo/engine/setup-libraw.sh" "$deps" | tail -n 1)"
+echo "old pin: $old_libraw" >&2
+echo "new pin: $new_libraw" >&2
+
+build() {   # name engine-src libraw
+  cmake -S "$here/raw_pin_compare" -B "$work/$1" -G Ninja -DCMAKE_BUILD_TYPE=Release \
+    -DSPK_ENGINE_SRC="$2" -DSPK_LIBRAW_SOURCE="$3" >/dev/null
+  ninja -C "$work/$1" >/dev/null
+}
+build old "$work/old-src/engine/src" "$old_libraw"
+build new "$repo/engine/src" "$new_libraw"
+
+python3 "$here/raw_fixtures.py" compare --old "$work/old" --new "$work/new" \
+  --scratch "$work/frames" --report "$work/report.json"
