+# The decoder alone, against a chosen LibRaw tree and a chosen copy of
+# engine/src/io -- so the previous pin and the current one can be built with
+# the same compiler and flags and their linear frames compared (T-A2).
+# raw_pin_compare.sh configures this twice; it is not part of the product
+# build and does not run the pin guard (the setup scripts verified each tree).
+#
+#   cmake -S engine/tests/raw_pin_compare -B <dir> -DSPK_ENGINE_SRC=<engine/src> \
+#         -DSPK_LIBRAW_SOURCE=<LibRaw tree>
+cmake_minimum_required(VERSION 3.20)
+project(spk_raw_pin_compare LANGUAGES C CXX)
+# The same language settings engine/CMakeLists.txt gives LibRaw and spk_image_io.
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_CXX_EXTENSIONS ON)
+if(NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release)
+endif()
+foreach(var SPK_ENGINE_SRC SPK_LIBRAW_SOURCE)
+    if(NOT EXISTS "${${var}}")
+        message(FATAL_ERROR "${var} is required")
+    endif()
+endforeach()
+file(GLOB_RECURSE libraw_sources "${SPK_LIBRAW_SOURCE}/src/*.cpp")
+list(FILTER libraw_sources EXCLUDE REGEX "/[^/]*_ph\\.cpp$")
+add_library(cmp_libraw STATIC ${libraw_sources})
+target_include_directories(cmp_libraw PUBLIC "${SPK_LIBRAW_SOURCE}")
+target_compile_definitions(cmp_libraw PUBLIC LIBRAW_NODLL SPEKTRALAB_RAW_OPENMP=0)
+target_compile_options(cmp_libraw PRIVATE -w)
+add_executable(raw_decode_dump raw_decode_dump.cpp
+    "${SPK_ENGINE_SRC}/io/raw_decoder.cpp" "${SPK_ENGINE_SRC}/io/raw_headroom.cpp")
+target_include_directories(raw_decode_dump PRIVATE "${SPK_ENGINE_SRC}")
+target_compile_features(raw_decode_dump PRIVATE cxx_std_20)
+target_link_libraries(raw_decode_dump PRIVATE cmp_libraw m)
+add_executable(raw_frame_compare raw_frame_compare.cpp)
diff --git a/engine/tests/raw_pin_compare/raw_decode_dump.cpp b/engine/tests/raw_pin_compare/raw_decode_dump.cpp
new file mode 100644
index 0000000..aae1286
--- /dev/null
+++ b/engine/tests/raw_pin_compare/raw_decode_dump.cpp
@@ -0,0 +1,85 @@
+// raw_decode_dump <raw> <compatible16|headroom> <out.spkf32>
+//
+// One RAW through spk::io's decoder, written as the linear frame the host
+// hands the engine: a text header, then width*height*3 float32 (native
+// endian, top row first). Built twice by raw_pin_compare.sh -- once against
+// the previous LibRaw pin and once against the current one -- so the two
+// frames can be compared value by value (raw_frame_compare.cpp).
+//
+// Header (one line each, then a blank line):
+//   SPKF32 1
+//   width <w>
+//   height <h>
+//   libraw <LibRaw::version()>
+//   make <make> / model <model> / decoder <unpack function>
+//   flip <LibRaw sizes.flip>
+//   nonfinite <count of NaN/Inf samples>
+//   sizes / levels / wb / camera_from_xyz: the calibration LibRaw used
+// Exit 0 when the decode succeeded, 3 when it failed (the error on stderr).
+#include "io/raw_decoder.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <string>
+
+int main(int argc, char** argv) {
+    if (argc != 4) {
+        std::cerr << "usage: raw_decode_dump <raw> <compatible16|headroom> <out>\n";
+        return 2;
+    }
+    const std::string mode = argv[2];
+    spk::io::DecodedRaw decoded;
+    std::string error;
+    bool ok = false;
+    if (mode == "compatible16") {
+        ok = spk::io::decode_raw_compatible(std::filesystem::u8path(argv[1]), decoded, error);
+    } else if (mode == "headroom") {
+        ok = spk::io::decode_raw_headroom(std::filesystem::u8path(argv[1]), decoded, error);
+    } else {
+        std::cerr << "unknown mode " << mode << "\n";
+        return 2;
+    }
+    if (!ok) {
+        std::cerr << error << "\n";
+        return 3;
+    }
+    if (decoded.rgb.size() != std::size_t(decoded.width) * decoded.height * 3) {
+        std::cerr << "decoded frame size does not match its dimensions\n";
+        return 4;
+    }
+    std::size_t nonfinite = 0;
+    for (float v : decoded.rgb)
+        if (!std::isfinite(v)) ++nonfinite;
+    std::FILE* out = std::fopen(argv[3], "wb");
+    if (!out) {
+        std::cerr << "cannot write " << argv[3] << "\n";
+        return 5;
+    }
+    const auto& m = decoded.metadata;
+    std::fprintf(out, "SPKF32 1\nwidth %u\nheight %u\nlibraw %s\nmake %s\nmodel %s\ndecoder %s\nflip %d\nnonfinite %zu\n",
+                 decoded.width, decoded.height, m.libraw_version.c_str(), m.make.c_str(), m.model.c_str(),
+                 m.decoder_name.c_str(), m.raw_flip, nonfinite);
+    // The calibration LibRaw used, so a changed frame can be traced to its cause.
+    const auto& s = m.sizes_before_postprocess;
+    std::fprintf(out, "sizes raw %ux%u visible %ux%u margins %u,%u\n", s.raw_width, s.raw_height, s.width, s.height,
+                 s.left_margin, s.top_margin);
+    std::fprintf(out, "levels black %u white %u per-channel-black %u,%u,%u,%u postprocess %u..%u\n", m.black, m.white_level,
+                 m.black_level_per_channel[0], m.black_level_per_channel[1], m.black_level_per_channel[2],
+                 m.black_level_per_channel[3], m.postprocess_black, m.postprocess_maximum);
+    std::fprintf(out, "wb as-shot %.6g,%.6g,%.6g,%.6g applied %.6g,%.6g,%.6g,%.6g\n", m.camera_whitebalance[0],
+                 m.camera_whitebalance[1], m.camera_whitebalance[2], m.camera_whitebalance[3], m.post_scale_pre_mul[0],
+                 m.post_scale_pre_mul[1], m.post_scale_pre_mul[2], m.post_scale_pre_mul[3]);
+    std::fprintf(out, "camera_from_xyz %.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g\n\n", m.camera_from_xyz[0],
+                 m.camera_from_xyz[1], m.camera_from_xyz[2], m.camera_from_xyz[3], m.camera_from_xyz[4],
+                 m.camera_from_xyz[5], m.camera_from_xyz[6], m.camera_from_xyz[7], m.camera_from_xyz[8]);
+    const std::size_t written = std::fwrite(decoded.rgb.data(), sizeof(float), decoded.rgb.size(), out);
+    if (std::fclose(out) != 0 || written != decoded.rgb.size()) {
+        std::cerr << "short write to " << argv[3] << "\n";
+        return 5;
+    }
+    std::printf("%s %ux%u %s %s %s flip=%d nonfinite=%zu\n", mode.c_str(), decoded.width, decoded.height,
+                m.make.c_str(), m.model.c_str(), m.decoder_name.c_str(), m.raw_flip, nonfinite);
+    return 0;
+}
diff --git a/engine/tests/raw_pin_compare/raw_frame_compare.cpp b/engine/tests/raw_pin_compare/raw_frame_compare.cpp
new file mode 100644
index 0000000..ef2a303
--- /dev/null
+++ b/engine/tests/raw_pin_compare/raw_frame_compare.cpp
@@ -0,0 +1,202 @@
+// raw_frame_compare <a.spkf32> <b.spkf32>
+//
+// Compares two frames raw_decode_dump wrote and prints one JSON object:
+// both headers, whether size and LibRaw flip agree, and the absolute
+// difference over the samples compared: max, mean, the share of samples that
+// differ at all and by more than one 16-bit code, the 99.9th percentile (from
+// a fixed histogram in 1/65535 steps), and the per-channel means of each side.
+// Values are in the decoder's linear [0,1] scale, so 1/65535 is one code of
+// LibRaw's 16-bit output.
+//
+// Same size: every sample. Different size with b at least as large as a in
+// both directions (a pin that crops less of the sensor): the offset of a
+// inside b is found first (the smallest mean difference over a sparse grid,
+// every offset tried), then a's interior -- a band of kAlignBorder pixels
+// left out, where the demosaic of a cropped frame sees an edge the larger
+// one does not -- is compared with the same pixels of b ("aligned": {...}).
+// No judgement is made here; raw_pin_compare.sh holds the expectation.
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr std::uint32_t kAlignBorder = 8;
+
+struct Frame {
+    std::map<std::string, std::string> header;
+    std::uint32_t width = 0, height = 0;
+    std::ifstream data;
+};
+
+bool open_frame(const char* path, Frame& f) {
+    f.data.open(path, std::ios::binary);
+    if (!f.data) return false;
+    std::string line;
+    if (!std::getline(f.data, line) || line != "SPKF32 1") return false;
+    while (std::getline(f.data, line) && !line.empty()) {
+        const auto space = line.find(' ');
+        f.header[line.substr(0, space)] = space == std::string::npos ? "" : line.substr(space + 1);
+    }
+    f.width = static_cast<std::uint32_t>(std::stoul(f.header["width"]));
+    f.height = static_cast<std::uint32_t>(std::stoul(f.header["height"]));
+    return true;
+}
+
+bool read_all(Frame& f, std::vector<float>& out) {
+    out.resize(std::size_t(f.width) * f.height * 3);
+    f.data.read(reinterpret_cast<char*>(out.data()), std::streamsize(out.size() * sizeof(float)));
+    return bool(f.data);
+}
+
+std::string quote(const std::string& s) {
+    std::string out = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') out += '\\';
+        out += c;
+    }
+    return out + "\"";
+}
+
+void print_header(const char* key, const Frame& f) {
+    std::printf("\"%s\":{", key);
+    bool first = true;
+    for (const auto& [k, v] : f.header) {
+        std::printf("%s%s:%s", first ? "" : ",", quote(k).c_str(), quote(v).c_str());
+        first = false;
+    }
+    std::printf("}");
+}
+
+struct Stats {
+    static constexpr std::size_t kBins = 65536 * 2;  // 0 .. 2.0 in 1/65535 steps; the last bin collects the rest
+    std::vector<std::uint64_t> histogram = std::vector<std::uint64_t>(kBins + 1, 0);
+    std::array<double, 3> sum_a{}, sum_b{};
+    double max_abs = 0.0, sum_abs = 0.0;
+    std::uint64_t differ = 0, differ_code = 0, nonfinite = 0, total = 0;
+
+    void add(double x, double y, std::size_t channel) {
+        if (!std::isfinite(x) || !std::isfinite(y)) {
+            ++nonfinite;
+            return;
+        }
+        sum_a[channel] += x;
+        sum_b[channel] += y;
+        const double d = std::fabs(x - y);
+        max_abs = std::max(max_abs, d);
+        sum_abs += d;
+        if (d > 0.0) ++differ;
+        if (d > 1.5 / 65535.0) ++differ_code;
+        ++histogram[std::min<std::size_t>(kBins, static_cast<std::size_t>(d * 65535.0))];
+        ++total;
+    }
+
+    void print() const {
+        const std::uint64_t target = static_cast<std::uint64_t>(std::ceil(double(total) * 0.999));
+        std::uint64_t running = 0;
+        std::size_t p999 = 0;
+        for (; p999 <= kBins; ++p999) {
+            running += histogram[p999];
+            if (running >= target) break;
+        }
+        const double per_channel = total ? double(total) / 3.0 : 1.0;
+        std::printf("\"samples\":%llu,\"nonfinite\":%llu,\"max_abs\":%.9g,\"mean_abs\":%.9g,"
+                    "\"share_differ\":%.9g,\"share_differ_over_1_code\":%.9g,\"p999_abs_codes\":%zu,"
+                    "\"mean_a\":[%.9g,%.9g,%.9g],\"mean_b\":[%.9g,%.9g,%.9g]",
+                    static_cast<unsigned long long>(total), static_cast<unsigned long long>(nonfinite), max_abs,
+                    total ? sum_abs / double(total) : 0.0, total ? double(differ) / double(total) : 0.0,
+                    total ? double(differ_code) / double(total) : 0.0, p999,
+                    sum_a[0] / per_channel, sum_a[1] / per_channel, sum_a[2] / per_channel,
+                    sum_b[0] / per_channel, sum_b[1] / per_channel, sum_b[2] / per_channel);
+    }
+};
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc != 3) {
+        std::cerr << "usage: raw_frame_compare <a> <b>\n";
+        return 2;
+    }
+    Frame a, b;
+    if (!open_frame(argv[1], a) || !open_frame(argv[2], b)) {
+        std::cerr << "not a raw_decode_dump frame\n";
+        return 2;
+    }
+    const bool same_size = a.width == b.width && a.height == b.height;
+    const bool same_flip = a.header["flip"] == b.header["flip"];
+    std::printf("{");
+    print_header("a", a);
+    std::printf(",");
+    print_header("b", b);
+    std::printf(",\"same_size\":%s,\"same_flip\":%s", same_size ? "true" : "false", same_flip ? "true" : "false");
+    if (same_size) {
+        Stats stats;
+        std::vector<float> ca(1 << 20), cb(1 << 20);
+        const std::uint64_t samples = std::uint64_t(a.width) * a.height * 3;
+        std::uint64_t done = 0;
+        while (done < samples) {
+            const std::size_t n = static_cast<std::size_t>(std::min<std::uint64_t>(ca.size(), samples - done));
+            a.data.read(reinterpret_cast<char*>(ca.data()), std::streamsize(n * sizeof(float)));
+            b.data.read(reinterpret_cast<char*>(cb.data()), std::streamsize(n * sizeof(float)));
+            if (!a.data || !b.data) {
+                std::cerr << "truncated frame\n";
+                return 2;
+            }
+            for (std::size_t i = 0; i < n; ++i) stats.add(ca[i], cb[i], static_cast<std::size_t>((done + i) % 3));
+            done += n;
+        }
+        std::printf(",");
+        stats.print();
+        std::printf("}\n");
+        return 0;
+    }
+    if (b.width < a.width || b.height < a.height || a.width <= 2 * kAlignBorder || a.height <= 2 * kAlignBorder) {
+        std::printf("}\n");
+        return 0;
+    }
+    std::vector<float> fa, fb;
+    if (!read_all(a, fa) || !read_all(b, fb)) {
+        std::cerr << "truncated frame\n";
+        return 2;
+    }
+    const auto at = [](const std::vector<float>& f, std::uint32_t w, std::uint32_t x, std::uint32_t y, unsigned c) {
+        return double(f[(std::size_t(y) * w + x) * 3 + c]);
+    };
+    // Every offset, scored on a 64 x 64 grid of a's interior.
+    std::uint32_t best_dx = 0, best_dy = 0;
+    double best = std::numeric_limits<double>::infinity();
+    for (std::uint32_t dy = 0; dy <= b.height - a.height; ++dy) {
+        for (std::uint32_t dx = 0; dx <= b.width - a.width; ++dx) {
+            double score = 0.0;
+            for (unsigned gy = 0; gy < 64; ++gy) {
+                const std::uint32_t y = kAlignBorder + gy * (a.height - 2 * kAlignBorder) / 64;
+                for (unsigned gx = 0; gx < 64; ++gx) {
+                    const std::uint32_t x = kAlignBorder + gx * (a.width - 2 * kAlignBorder) / 64;
+                    for (unsigned c = 0; c < 3; ++c)
+                        score += std::fabs(at(fa, a.width, x, y, c) - at(fb, b.width, x + dx, y + dy, c));
+                }
+            }
+            if (score < best) {
+                best = score;
+                best_dx = dx;
+                best_dy = dy;
+            }
+        }
+    }
+    Stats stats;
+    for (std::uint32_t y = kAlignBorder; y < a.height - kAlignBorder; ++y)
+        for (std::uint32_t x = kAlignBorder; x < a.width - kAlignBorder; ++x)
+            for (unsigned c = 0; c < 3; ++c)
+                stats.add(at(fa, a.width, x, y, c), at(fb, b.width, x + best_dx, y + best_dy, c), c);
+    std::printf(",\"aligned\":{\"offset_x\":%u,\"offset_y\":%u,\"border\":%u,", best_dx, best_dy, kAlignBorder);
+    stats.print();
+    std::printf("}}\n");
+    return 0;
+}
diff --git a/engine/tests/raw_pin_guard.sh b/engine/tests/raw_pin_guard.sh
new file mode 100755
index 0000000..36e11ca
--- /dev/null
+++ b/engine/tests/raw_pin_guard.sh
@@ -0,0 +1,140 @@
+#!/usr/bin/env bash
+# raw_pin_guard.sh -- T-A3: the LibRaw pin guards can fire.
+#
+#   engine/tests/raw_pin_guard.sh [work-dir]      (default <repo>/build/raw-pin-guard)
+#
+# 1. The four places that name the pin agree: setup-libraw.sh, setup-libraw.ps1,
+#    cmake/LibRaw.cmake (commit, tree, archive SHA-256) and the directory the
+#    Windows build scripts expect.
+# 2. setup-libraw.sh, on scratch copies of the verified tree and archive:
+#    accepts the untouched copy (the control), and refuses an edited file, an
+#    added file, a removed file, an archive with one byte changed, and a git
+#    checkout of another commit -- each with its own message.
+# 3. cmake/LibRaw.cmake, configured against scratch trees: accepts the untouched
+#    tree (the control), and refuses another version (libraw_version.h says
+#    0.22.2), an edited file, an added file and a removed file.
+# Nothing here touches the real build/deps tree. setup-libraw.ps1 is checked
+# for its pin only: there is no PowerShell on this Mac to run it.
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+engine="$(cd "$here/.." && pwd)"
+repo="$(cd "$engine/.." && pwd)"
+work="${1:-$repo/build/raw-pin-guard}"
+deps="${SPEKTRALAB_DEPS_DIR:-$repo/build/deps}"
+failures=0
+ok()   { echo "ok   $*"; }
+fail() { echo "FAIL $*"; failures=$((failures + 1)); }
+
+# --- 1. one pin, everywhere -----------------------------------------------------------------
+value() { sed -n -E "s/^$2=([0-9a-f]+)\$/\\1/p" "$1" | head -n 1; }
+commit="$(value "$engine/setup-libraw.sh" git_commit)"
+tree="$(value "$engine/setup-libraw.sh" git_tree)"
+zipsha="$(value "$engine/setup-libraw.sh" zip_sha256)"
+[[ ${#commit} == 40 && ${#tree} == 40 && ${#zipsha} == 64 ]] && ok "setup-libraw.sh names a commit, a tree and a SHA-256" \
+  || fail "setup-libraw.sh pin unreadable ($commit / $tree / $zipsha)"
+ps1="$engine/setup-libraw.ps1"
+grep -q "^\$commit = '$commit'\$" "$ps1" && grep -q "^\$tree = '$tree'\$" "$ps1" && grep -q "^\$expected = '$zipsha'\$" "$ps1" \
+  && ok "setup-libraw.ps1 has the same commit, tree and SHA-256" || fail "setup-libraw.ps1 pin differs from setup-libraw.sh"
+cm="$engine/cmake/LibRaw.cmake"
+grep -q "^set(SPEKTRALAB_LIBRAW_COMMIT $commit)\$" "$cm" && grep -q "^set(SPEKTRALAB_LIBRAW_TREE $tree)\$" "$cm" \
+  && ok "cmake/LibRaw.cmake has the same commit and tree" || fail "cmake/LibRaw.cmake pin differs from setup-libraw.sh"
+for f in "$engine/build-windows.ps1" "$repo/windows_UI/build.ps1" "$repo/.github/workflows/desktop.yml"; do
+  if grep -q "LibRaw-0\.22" "$f" || ! grep -q "LibRaw-$commit" "$f"; then
+    fail "${f#$repo/} does not name LibRaw-$commit"
+  else
+    ok "${f#$repo/} names LibRaw-$commit"
+  fi
+done
+
+# --- 2. the setup script --------------------------------------------------------------------
+source_dir="$("$engine/setup-libraw.sh" "$deps" | tail -n 1)"
+archive="$deps/LibRaw-$commit.zip"
+[[ -f "$archive" && -d "$source_dir" ]] || { fail "the verified LibRaw tree and archive are not in $deps"; exit 1; }
+rm -rf "$work"
+mkdir -p "$work"
+fresh() {   # a scratch deps dir holding a copy of the verified tree and archive
+  rm -rf "$work/deps"
+  mkdir -p "$work/deps"
+  cp "$archive" "$work/deps/"
+  cp -R "$source_dir" "$work/deps/"
+}
+refuses() {   # label expected-message: setup-libraw.sh must fail and say why
+  local out
+  if out="$("$engine/setup-libraw.sh" "$work/deps" 2>&1)"; then
+    fail "setup-libraw.sh accepted $1"
+  elif grep -q "$2" <<<"$out"; then
+    ok "setup-libraw.sh refuses $1 ($(grep "$2" <<<"$out" | head -n 1 | sed "s|$work/||g"))"
+  else
+    fail "setup-libraw.sh refused $1 for another reason: $out"
+  fi
+}
+fresh
+if out="$("$engine/setup-libraw.sh" "$work/deps" 2>&1)" && [[ "$(tail -n 1 <<<"$out")" == "$work/deps/LibRaw-$commit" ]]; then
+  ok "setup-libraw.sh accepts an untouched copy (control)"
+else
+  fail "setup-libraw.sh rejected an untouched copy: $out"
+fi
+victim="src/decoders/sony_arw6.cpp"
+fresh; printf '\n// local patch\n' >> "$work/deps/LibRaw-$commit/$victim"
+refuses "an edited file" "Modified LibRaw source file"
+fresh; echo x > "$work/deps/LibRaw-$commit/src/extra.cpp"
+refuses "an added file" "Unexpected file in pinned LibRaw source"
+fresh; rm "$work/deps/LibRaw-$commit/src/decoders/nikonhe.cpp"
+refuses "a removed file" "Incomplete LibRaw source tree"
+fresh; rm -rf "$work/deps/LibRaw-$commit"
+python3 - "$work/deps/LibRaw-$commit.zip" <<'PY'
+import sys
+p = sys.argv[1]; b = bytearray(open(p, 'rb').read()); b[len(b) // 2] ^= 0x01; open(p, 'wb').write(bytes(b))
+PY
+refuses "an archive with one byte changed" "checksum mismatch"
+[[ ! -e "$work/deps/LibRaw-$commit" ]] && ok "nothing was extracted from the bad archive" || fail "the bad archive was extracted"
+# A git checkout of another commit: the same commit id check the git fallback uses.
+fresh; rm -rf "$work/deps/LibRaw-$commit"; mkdir -p "$work/deps/LibRaw-$commit"
+cp -R "$source_dir/." "$work/deps/LibRaw-$commit/"
+(cd "$work/deps/LibRaw-$commit" && git init -q && git add -A && git -c user.name=guard -c user.email=guard@invalid commit -qm other)
+refuses "a git checkout of another commit" "is not the pinned commit"
+
+# --- 3. the CMake check ---------------------------------------------------------------------
+mkdir -p "$work/cmake"
+cat > "$work/cmake/CMakeLists.txt" <<EOF
+cmake_minimum_required(VERSION 3.20)
+project(libraw_pin_guard CXX)
+set(SPEKTRALAB_DEPS_DIR "\${CMAKE_CURRENT_BINARY_DIR}/unused")
+set(SPEKTRALAB_LIBRAW_OPENMP OFF CACHE BOOL "" FORCE)
+include("$engine/cmake/LibRaw.cmake")
+EOF
+tree_copy() {
+  rm -rf "$work/tree"
+  cp -R "$source_dir" "$work/tree"
+}
+configure() { cmake -S "$work/cmake" -B "$work/cmake-build" -DSPEKTRALAB_LIBRAW_SOURCE="$work/tree" 2>&1; }
+cmake_refuses() {   # label expected-message
+  local out
+  rm -rf "$work/cmake-build"
+  if out="$(configure)"; then
+    fail "cmake/LibRaw.cmake accepted $1"
+  elif grep -q "$2" <<<"$out"; then
+    ok "cmake/LibRaw.cmake refuses $1"
+  else
+    fail "cmake/LibRaw.cmake refused $1 for another reason: $(grep -A3 'CMake Error' <<<"$out" | head -n 6)"
+  fi
+}
+tree_copy; rm -rf "$work/cmake-build"
+if out="$(configure)"; then ok "cmake/LibRaw.cmake accepts the pinned tree (control)"; else fail "cmake/LibRaw.cmake rejected the pinned tree: $out"; fi
+tree_copy
+sed -i.bak -e 's/^#define LIBRAW_MINOR_VERSION 23$/#define LIBRAW_MINOR_VERSION 22/' \
+           -e 's/^#define LIBRAW_PATCH_VERSION 0$/#define LIBRAW_PATCH_VERSION 2/' \
+           -e 's/^#define LIBRAW_VERSION_TAIL Snapshot202611$/#define LIBRAW_VERSION_TAIL Release/' "$work/tree/libraw/libraw_version.h"
+rm -f "$work/tree/libraw/libraw_version.h.bak"
+cmake_refuses "a tree that says it is 0.22.2" "is a different version"
+tree_copy; printf '\n// local patch\n' >> "$work/tree/$victim"
+cmake_refuses "an edited file" "differs from the pinned"
+tree_copy; echo x > "$work/tree/src/extra.cpp"
+cmake_refuses "an added file" "Unexpected file in the pinned LibRaw tree"
+tree_copy; rm "$work/tree/src/decoders/nikonhe.cpp"
+cmake_refuses "a removed file" "is missing src/decoders/nikonhe.cpp"
+
+rm -rf "$work"
+echo
+echo "$failures failure(s)"
+[[ $failures == 0 ]]
