+// micrometre-specified effect downstream converts with. Neither of those needs
+// the frame to *exist*: both are decisions, and they are made once from the
+// source's own shape (`film_prefix_begin`) rather than from a plane. What is
+// left of the prefix is pixels, and `node_geometry_band` produces any row
+// window of them -- so a band leaves the prefix with its halo rows already
+// computed, which is also why the first run no longer copies at the boundary.
+//
+// A stage that demands the frame (`film_boost`, `film_overscan`, `film_grain`)
+// materialises the whole prefix the moment it is reached; from then on `cur` is
+// a plane and the bands are cut from it exactly as step 5 did. That is the one
+// place this executor is not streaming, and it is a property of those three
+// nodes rather than of the prefix.
+bool Pipeline::run_film_banded(const Image& in, Image& out, uint32_t band_rows, std::string& error) {
+    if (!built_) { error = "pipeline was not built"; return false; }
+    progress_ = nullptr;
+    last_ae_ev_.reset();
+    if (band_rows == 0) return run_film(in, out, nullptr, error);
+    PrefixStream prefix;
+    if (!film_prefix_begin(in, FrameShape{in.h, in.w}, prefix, error)) return false;
+    const uint32_t frame_h = prefix.frame.h;
+    const uint32_t frame_w = prefix.frame.w;
+    const size_t row_bytes = size_t(frame_w) * 3 * sizeof(float);
+
+    // The executor's per-band state must not outlive the run, on any exit: a
+    // `band_row0_` left behind would seed the *next* render's noise from the
+    // middle of its own picture.
+    struct BandState {
+        Pipeline* p;
+        ~BandState() { p->band_row0_ = 0; p->strip_plane_h_ = 0; }
+    } band_state{this};
+
+    // `cur` is a **Chain, not an Image**: from `film_log_and_curves` to
+    // `film_couplers` the film side carries two live planes, and a crossing that
+    // kept only `cur.cur` handed the couplers an empty `log_e_film` -- which is
+    // exactly what the old "run it whole" guard was hiding.
+    Chain cur;
+    auto materialise_prefix = [&]() -> bool {
+        if (cur.cur.valid()) return true;
+        if (!film_prefix_whole(prefix, cur.cur, error)) return false;
+        prefix.source = Image{};   // the decoded source is not needed again
+        return true;
+    };
+    // A meter with nothing injected has to see the frame, so that configuration
+    // is whole-prefix by definition -- not a fallback.
+    if (prefix.whole_required && !materialise_prefix()) return false;
+
+    auto band_able = [&](size_t k, uint32_t& halo) -> bool {
+        const Stage& st = kFilmStages[k];
+        if (st.klass == StageClass::Pointwise) { halo = 0; return true; }
+        if (st.klass == StageClass::Neighbourhood && st.demand) {
+            const Blur::Demand d = (this->*st.demand)();
+            halo = d.halo;
+            return !d.carried;
+        }
+        return false;
+    };
+
+    // **Two stages that may not be cut apart.** The chain carries `log_e_film`
+    // from `film_log_and_curves` to `film_couplers`, so a run that ended between
+    // them would have to hand the next run a value it never assembled. The
+    // producer is therefore banded only when its consumer is in the same run;
+    // otherwise it runs whole, like the stage it has to stay beside. This is a
+    // dependency between two nodes and not a property of either, which is why it
+    // is read off the table here instead of being another `StageClass`.
