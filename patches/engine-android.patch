+bool write_dng(const std::filesystem::path& destination, const uint16_t* rgba,
+               uint32_t width, uint32_t height, uint32_t row_stride_px, std::string& error) {
+    error.clear();
+    if (!rgba || !width || !height || row_stride_px < width) {
+        error = "DNG export needs pixels and a row stride at least as wide as the image";
+        return false;
+    }
+    const uint64_t pixels = uint64_t(width) * uint64_t(height);
+    if (pixels > (1ull << 31) || pixels * 6 > (1ull << 31)) {
+        error = "DNG export is too large for a classic TIFF";
+        return false;
+    }
+
+    struct Field { uint16_t tag, type; uint32_t count, value; };
+    constexpr uint16_t field_count = 16;
+    const size_t ifd_at = 8;
+    const size_t values_at = ifd_at + 2 + size_t(field_count) * 12 + 4;
+
+    std::vector<uint8_t> extra;
+    const auto add_extra = [&](const void* data, size_t bytes) -> uint32_t {
+        const size_t at = values_at + extra.size();
+        const uint8_t* p = static_cast<const uint8_t*>(data);
+        extra.insert(extra.end(), p, p + bytes);
+        return uint32_t(at);
+    };
+    const uint16_t bits[3] = {16, 16, 16};
+    const uint16_t sample_format[3] = {1, 1, 1};
+    const uint32_t resolution[2] = {72, 1};
+    const uint32_t bits_at = add_extra(bits, sizeof bits);
+    const uint32_t format_at = add_extra(sample_format, sizeof sample_format);
+    const uint32_t resolution_at = add_extra(resolution, sizeof resolution);
+
+    const size_t pixels_at = (values_at + extra.size() + 1) & ~size_t(1);
+    const uint32_t image_bytes = uint32_t(pixels * 6);
+    const std::array<Field, field_count> fields = {{
+        {256, 4, 1, width}, {257, 4, 1, height}, {258, 3, 3, bits_at},
+        {259, 3, 1, 1}, {262, 3, 1, 2},
+        {273, 4, 1, uint32_t(pixels_at)}, {277, 3, 1, 3},
+        {278, 4, 1, height}, {279, 4, 1, image_bytes},
+        {282, 5, 1, resolution_at}, {283, 5, 1, resolution_at},
+        {284, 3, 1, 1}, {296, 3, 1, 2}, {339, 3, 3, format_at},
+        {50706, 1, 4, 0x00000401u}, {50707, 1, 4, 0x00000101u}
+    }};
+
+    std::vector<uint8_t> bytes(pixels_at + image_bytes, 0);
+    bytes[0] = bytes[1] = 'I';
+    le16(bytes, 2, 42);
+    le32(bytes, 4, 8);
+    le16(bytes, 8, field_count);
+    for (size_t i = 0; i < fields.size(); ++i) {
+        const size_t at = 10 + i * 12;
+        le16(bytes, at, fields[i].tag);
+        le16(bytes, at + 2, fields[i].type);
+        le32(bytes, at + 4, fields[i].count);
+        le32(bytes, at + 8, fields[i].value);
+    }
+    le32(bytes, 10 + field_count * 12, 0);  // no next IFD
+    std::copy(extra.begin(), extra.end(), bytes.begin() + values_at);
+
+    size_t at = pixels_at;
+    for (uint32_t y = 0; y < height; ++y) {
+        const uint16_t* row = rgba + size_t(y) * row_stride_px * 4;
+        for (uint32_t x = 0; x < width; ++x) {
+            for (uint32_t c = 0; c < 3; ++c) {
+                le16(bytes, at, row[size_t(x) * 4 + c]);
+                at += 2;
+            }
+        }
+    }
+
+    std::ofstream out(destination, std::ios::binary | std::ios::trunc);
+    if (!out) { error = "cannot create DNG export"; return false; }
+    out.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()));
+    out.close();
+    if (!out) { error = "DNG export write failed"; return false; }
+    return true;
+}
